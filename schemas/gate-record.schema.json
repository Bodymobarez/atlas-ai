{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://atlas-ai.local/schemas/gate-record.schema.json",
  "title": "AtlasAIGateRecord",
  "type": "object",
  "required": ["gate_id", "name", "status", "timestamp"],
  "properties": {
    "gate_id": {
      "type": "string",
      "pattern": "^G([0-9]|10)$"
    },
    "name": { "type": "string" },
    "status": {
      "type": "string",
      "enum": ["open", "closed", "waived", "na"]
    },
    "approver": { "type": "string" },
    "timestamp": { "type": "string", "format": "date-time" },
    "evidence_paths": {
      "type": "array",
      "items": { "type": "string" }
    },
    "notes": { "type": "string" },
    "waiver_expiry": { "type": ["string", "null"], "format": "date" }
  },
  "additionalProperties": true
}
